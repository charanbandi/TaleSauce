# OpenClaw (OpenAI-compatible chat completions endpoint)
OPENCLAW_API_URL=https://neoclaw-admin-us-west-1.securebrowser.com/api/gw/v1/chat/completions
OPENCLAW_API_KEY=replace_with_your_key
OPENCLAW_TASK_MODEL=
OPENCLAW_IDLE_MODEL=

# Server / web
SERVER_PORT=8787
WEB_PORT=5173
DB_PATH=./talesauce.sqlite

# ── Local Claude Code brain (Phase 2) ───────────────────────────────
# Set this if you're logged into Claude Code locally:
CLAUDE_CODE_ENABLED=false
# Or provide an Anthropic API key instead of a local login:
# ANTHROPIC_API_KEY=sk-ant-...

# ── Codex CLI brain (Phase 3) ────────────────────────────────────────
# Requires: npm i -g @openai/codex && codex login
# Enable after installing:
CODEX_ENABLED=false

# ── Cursor CLI brain (Phase 3) ───────────────────────────────────────
# Requires: cursor-agent installed and logged in
# Enable after installing:
CURSOR_ENABLED=false

# Which brain to start with when more than one is configured (optional):
# DEFAULT_BRAIN=claudecode
