{
  "name": "talesauce",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm -w @talesauce/server run dev",
    "dev:web": "npm -w @talesauce/web run dev",
    "build": "npm -w @talesauce/shared run build && npm -w @talesauce/server run build && npm -w @talesauce/web run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
